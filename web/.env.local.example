# ==============================================================================
# Nexus Web Client Environment Configuration Example
# Copy to .env.local before running the Next.js frontend
# ==============================================================================

# Backend API & WebSocket Endpoints
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=http://localhost:8080

# AWS Cognito Client Configuration
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Google OAuth Client Configuration
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com

# GitHub OAuth (public Client ID only — secret stays server-side)
NEXT_PUBLIC_GITHUB_CLIENT_ID=Ov23xxxxxxxxxxxxxxxxxx

# Web Push (VAPID Public Key)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX=

# Optional WebRTC TURN Relay (for strict symmetric corporate NATs)
NEXT_PUBLIC_TURN_URL=turn:turn.nexus.app:3478
NEXT_PUBLIC_TURN_USERNAME=nexus
NEXT_PUBLIC_TURN_CREDENTIAL=nexuspassword

# React Bits Pro (private shadcn registry for Blinking Squares etc.)
# Get your key from https://pro.reactbits.dev and keep it secret.
REACTBITS_LICENSE_KEY=
