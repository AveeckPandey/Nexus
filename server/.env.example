# ==============================================================================
# Nexus Server Environment Configuration Example
# Copy to .env and configure values before starting the API server
# ==============================================================================

# Server Network Configuration
PORT=8080
NODE_ENV=production
CLIENT_ORIGIN=https://nexus.app

# JWT & Session Security
# Must be a cryptographically secure random string of 32+ characters
SESSION_JWT_SECRET=min_32_chars_random_hex_secret_key_nexus_prod
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
# GitHub OAuth (login) — Client ID is public; secret stays server-side only.
GITHUB_CLIENT_ID=Ov23xxxxxxxxxxxxxxxxxx
GITHUB_CLIENT_SECRET=

# AWS Authentication & Region
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS Cognito User Pool
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_CLIENT_SECRET=

# AWS DynamoDB Single-Table
DYNAMODB_TABLE_NAME=NexusTable

# AWS S3 & CloudFront Media Delivery
S3_BUCKET_NAME=nexus-media-production
CLOUDFRONT_DOMAIN=https://d111111abcdef8.cloudfront.net

# Redis Adapter (Optional for multi-node clusters; memory fallback if empty)
REDIS_URL=redis://default:token@cluster-url.upstash.io:6379

# Groq AI Service (Summarization)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# Web Push (VAPID)
VAPID_PUBLIC_KEY=BXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX=
VAPID_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx=
VAPID_SUBJECT=mailto:admin@nexus.app

# ------------------------------------------------------------------------------
# Security gates (fail-closed defaults — production keeps these untouched)
# ------------------------------------------------------------------------------
# Local-dev auth fallback (signup/login without Cognito). Production refuses to
# mint tokens without Cognito unless this is explicitly 'true' (dev only).
ALLOW_DEV_AUTH=false
# Self-asserted load-test WS identities (bench/breaker/isBenchmark). Required
# for makeittobreakit fallbacks and legacy bench runners; real-token harnesses
# (benchmark-1k/10k, worker-runner) do not need it.
ALLOW_BENCHMARK_AUTH=false
# Per-IP WebSocket handshake limit per minute (all gateways). Raise for
# single-box load generators or NAT'd enterprise egress; never 0.
WS_THROTTLE_PER_MIN=60
