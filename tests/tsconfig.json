{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "isolatedModules": true,
    "types": ["jest", "node"],
    "lib": ["ES2021", "DOM"]
  },
  "include": ["./**/*.ts", "../server/src/**/*.ts", "../web/lib/**/*.ts"]
}
